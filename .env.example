# Copy to .env.local for local dev. On Vercel, set these under
# Project Settings → Environment Variables instead.

# Postgres connection string (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL=

# Admin login — email is plain text; password should be a bcrypt hash in
# production (generate with: node -e "console.log(require('bcryptjs').hashSync('yourpass',12))")
# Plain-text ADMIN_PASSWORD also works but is dev-only, not for production.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# NextAuth v5 requires this in production — generate with: npx auth secret
AUTH_SECRET=

# Cloudinary (image uploads/transforms)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing order-confirmation email, sent via Gmail (App Password, not
# your real Google password: Google Account → Security → App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Where the "new order" notification goes — defaults to GMAIL_USER if unset
ORDER_NOTIFY_EMAIL=
# Dev-only: set to point at a local mail catcher (e.g. Mailhog) instead of
# real Gmail so order emails can be tested without sending real mail.
# Leave both unset in production.
# SMTP_HOST=
# SMTP_PORT=2525

# Public site config (exposed to the browser — no secrets here)
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_ADDRESS=
NEXT_PUBLIC_WHATSAPP=
