# next-auth@5.0.0-beta declares peer support only up to Next 15, but works
# fine on Next 16 (we use the Credentials provider, which is unaffected).
# Without this, `npm install` fails with ERESOLVE — locally and on Vercel.
# Remove once next-auth v5 ships a stable release that lists Next 16.
legacy-peer-deps=true
